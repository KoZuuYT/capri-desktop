<Project Sdk="Microsoft.NET.Sdk">
  <!-- one source, two programs: built with Uninstaller=true it's the small Uninstall.exe; otherwise it's the
       setup, which carries the self-contained Capri.exe and that Uninstall.exe inside it -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>..\..\src\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Capri-Mod-Setup</AssemblyName>
    <RootNamespace>CapriSetup</RootNamespace>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Capri (mod)</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Uninstaller)' == 'true'">
    <AssemblyName>Uninstall</AssemblyName>
    <DefineConstants>$(DefineConstants);UNINSTALLER</DefineConstants>
    <IntermediateOutputPath>obj\uninstall\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Uninstaller)' != 'true'">
    <EmbeddedResource Include="..\app\Capri.exe" LogicalName="Capri.exe" />
    <EmbeddedResource Include="..\uninstall\Uninstall.exe" LogicalName="Uninstall.exe" />
  </ItemGroup>
</Project>
